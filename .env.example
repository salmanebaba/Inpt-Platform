# Development database only. Docker uses the db hostname internally.
DATABASE_URL=postgresql://smartresto:smartresto-demo-only@localhost:5432/smartresto?schema=public
# npm run setup generates independent random secrets in an ignored .env.
# Docker generates and persists missing demo secrets in its demo_secrets volume.
JWT_SECRET=
COUPON_HASH_KEY=
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
PORT=3000
MEAL_PRICE_CENTS=140
ENABLE_SWAGGER=true
